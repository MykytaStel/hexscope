{
  "name": "hexscope",
  "short_name": "hexscope",
  "description": "See what your files say about you: what they reveal, where they are broken, and how they work, byte by byte.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16171a",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "video/mp4",
            "video/quicktime",
            "application/zip",
            "application/pdf",
            ".pdf",
            ".mp4",
            ".mov",
            ".png",
            ".jpg",
            ".jpeg",
            ".heic",
            ".heif",
            ".avif",
            ".zip",
            ".docx",
            ".xlsx",
            ".pptx",
            ".wasm",
            "application/wasm",
            "message/rfc822",
            ".eml",
            "image/webp",
            ".webp",
            "image/gif",
            ".gif",
            "audio/mp4",
            ".m4a",
            ".epub",
            "application/msword",
            ".doc",
            "application/vnd.ms-excel",
            ".xls",
            "application/vnd.ms-powerpoint",
            ".ppt",
            "application/vnd.ms-outlook",
            ".msg"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/zip": [
          ".zip"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "message/rfc822": [
          ".eml"
        ],
        "application/wasm": [
          ".wasm"
        ],
        "application/msword": [
          ".doc",
          ".dot"
        ],
        "application/vnd.ms-excel": [
          ".xls",
          ".xlt"
        ],
        "application/vnd.ms-powerpoint": [
          ".ppt",
          ".pps",
          ".pot"
        ],
        "application/vnd.ms-outlook": [
          ".msg"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
