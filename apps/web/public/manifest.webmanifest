{
  "name": "hexscope",
  "short_name": "hexscope",
  "description": "See what your files say about you: what they reveal, where they are broken, and how they work, byte by byte.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16171a",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "video/mp4", "video/quicktime", "application/zip", "application/pdf", ".pdf", ".mp4", ".mov", ".png", ".jpg", ".jpeg", ".heic", ".heif", ".avif", ".zip", ".docx", ".xlsx", ".pptx", ".wasm", "application/wasm"]
        }
      ]
    }
  }
}
