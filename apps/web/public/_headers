# Cloudflare Pages headers. hexscope opens files people do not trust, so the
# page may run only its own code: no inline scripts, nothing from elsewhere,
# and nothing sent anywhere ('self' only for connect-src, to fetch samples).
# 'wasm-unsafe-eval' lets the parser's WebAssembly compile, and nothing else.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# File names carry a content hash: cache them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
