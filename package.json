{
  "name": "hexscope",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "wasm": "pnpm wasm:explain && pnpm wasm:media && pnpm wasm:pdf && pnpm wasm:docs && pnpm wasm:audio && pnpm wasm:raster",
    "wasm:explain": "cargo run -q -p hexscope-wasm --features audio --example explanations -- apps/web/src/explanations",
    "wasm:media": "node scripts/wasm-build.mjs media",
    "wasm:pdf": "node scripts/wasm-build.mjs pdf",
    "wasm:docs": "node scripts/wasm-build.mjs docs",
    "wasm:audio": "node scripts/wasm-build.mjs audio",
    "dev": "pnpm wasm && pnpm --filter web dev",
    "build": "pnpm wasm && pnpm --filter web build",
    "wasm:raster": "node scripts/wasm-build.mjs raster",
    "perf:size": "node scripts/wasm-size.mjs",
    "perf:browser": "pnpm --filter web exec playwright test --config=playwright.perf.config.ts",
    "perf:wasm": "node scripts/perf-wasm.mjs",
    "perf:compare": "node scripts/perf-compare.mjs",
    "perf:test": "node --test scripts/perf-report.test.mjs scripts/wasm-profile.test.mjs scripts/wasm-build.test.mjs",
    "perf:profile": "node scripts/wasm-profile.mjs",
    "perf:profile:named": "node scripts/wasm-profile-build.mjs",
    "stats": "node scripts/stats.mjs",
    "feedback": "node scripts/feedback.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "exiftool-vendored.pl": "13.59.2"
  },
  "engines": {
    "node": ">=24"
  }
}
